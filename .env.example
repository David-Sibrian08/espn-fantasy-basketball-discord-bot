# Copy this file to .env and fill in your own values.
# Never commit your actual .env file — it contains secrets.

# Discord bot token, from https://discord.com/developers/applications
# (Applications > Your App > Bot > Reset Token)
DISCORD_TOKEN=

# Optional, for local development only: registers slash commands to just this
# one Discord server ID instead of globally, so command changes show up
# instantly instead of waiting up to an hour. Leave unset in production --
# the bot automatically clears whichever scope (global vs this guild) isn't
# currently in use, so switching this on/off never leaves duplicate commands
# behind.
# GUILD_ID=

# Your bot's Application ID, from Applications > Your App > General Information
# (Not currently used by the bot itself, but handy to keep alongside the token)
DISCORD_CLIENT_ID=

# Discord channel ID where the weekly recap should be posted.
# Leave blank/commented out to disable the automatic weekly recap scheduler.
# Get a channel ID by enabling Developer Mode in Discord (User Settings >
# Advanced), then right-click the channel > Copy Channel ID.
# RECAP_CHANNEL_ID=

# Discord channel ID for lineup health alerts (OUT/DOUBTFUL players about to
# start). Leave blank/commented out to disable. Also requires team_owners.json
# to be set up (copy team_owners.example.json) so alerts can @mention owners.
# LINEUP_ALERT_CHANNEL_ID=

# Your ESPN league ID, found in the URL when viewing your league on
# fantasy.espn.com, e.g. .../leagues/lm-team?leagueId=123456 -> 123456
ESPN_LEAGUE_ID=

# The season year, e.g. 2026 for the 2025-26 NBA season.
ESPN_SEASON_ID=2026

# The first season your league existed, used for history-spanning stats
# (all-time records, head-to-head). Leave unset to only count the current
# season -- there's no safe default since every league's start year differs.
# ESPN_FIRST_SEASON_ID=2019

# Required only for private leagues. Get these by logging into
# fantasy.espn.com in your browser, opening DevTools > Application/Storage >
# Cookies, and copying the values of "espn_s2" and "SWID" (SWID includes the
# surrounding curly braces).
ESPN_S2=
SWID=
