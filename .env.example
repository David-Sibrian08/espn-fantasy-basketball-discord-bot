# Copy this file to .env and fill in your own values.
# Never commit your actual .env file — it contains secrets.

# Discord bot token, from https://discord.com/developers/applications
# (Applications > Your App > Bot > Reset Token)
DISCORD_TOKEN=

# Your bot's Application ID, from Applications > Your App > General Information
# (Not currently used by the bot itself, but handy to keep alongside the token)
DISCORD_CLIENT_ID=

# Discord channel ID where the weekly recap should be posted.
# Leave blank/commented out to disable the automatic weekly recap scheduler.
# Get a channel ID by enabling Developer Mode in Discord (User Settings >
# Advanced), then right-click the channel > Copy Channel ID.
# RECAP_CHANNEL_ID=

# Your ESPN league ID, found in the URL when viewing your league on
# fantasy.espn.com, e.g. .../leagues/lm-team?leagueId=123456 -> 123456
ESPN_LEAGUE_ID=

# The season year, e.g. 2026 for the 2025-26 NBA season.
ESPN_SEASON_ID=2026

# Required only for private leagues. Get these by logging into
# fantasy.espn.com in your browser, opening DevTools > Application/Storage >
# Cookies, and copying the values of "espn_s2" and "SWID" (SWID includes the
# surrounding curly braces).
ESPN_S2=
SWID=
